###############################################################################
# Multi-Chat Streamer Hub con TTS — configuración única del proyecto
#
# Copia este archivo a `.env` (en esta misma carpeta) y rellena lo que necesites:
#
#     cp .env.example .env          # macOS / Linux
#     copy .env.example .env        # Windows (cmd)
#
# `.env` está git-ignorado: NUNCA se commitea. Este `.env.example` sí, así que
# no pongas valores reales acá.
#
# Lo leen el backend (`backend/src/config.js`) y el frontend
# (`frontend/vite.config.js`), así que es el único lugar donde hay que tocar
# configuración. Todo lo que está comentado usa el default que se indica; podés
# arrancar con solo las dos variables de la sección 1 rellenas.
#
# Precedencia: variables del entorno del proceso > este archivo > `backend/.env`
# (que se sigue leyendo por compatibilidad, pero ya no es necesario).
###############################################################################


# ─── 1. REQUERIDAS ───────────────────────────────────────────────────────────
# Credenciales de tu aplicación de Twitch (https://dev.twitch.tv/console).
# Sin estas dos el backend se niega a arrancar y te dice cuál falta.
# En la app de Twitch, el "OAuth Redirect URL" debe coincidir EXACTAMENTE con
# TWITCH_REDIRECT_URI (por default, con HTTPS=true: https://localhost:3000/auth/callback).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=


# ─── 2. HTTPS ────────────────────────────────────────────────────────────────
# Twitch EXIGE `https` en los redirect URI, así que para usar la app de verdad
# hay que servirla sobre HTTPS. Con `true`, el backend y el dev server de Vite
# usan el certificado local, y los defaults de TWITCH_REDIRECT_URI y FRONTEND_URL
# pasan solos a `https` (no hay que sincronizarlos a mano).
#
# Generar el certificado una sola vez, desde la raíz del repo:
#     brew install mkcert          # macOS;  Windows: choco install mkcert
#     mkcert -install              # confía la CA local (pide contraseña)
#     mkdir -p certs && cd certs && mkcert localhost 127.0.0.1 ::1
#     # renombrar a localhost.pem / localhost-key.pem
#
# `certs/` está git-ignorado: la clave privada nunca se commitea.
HTTPS=true

# Rutas de los certificados. Defaults: certs/localhost.pem y certs/localhost-key.pem
# TLS_CERT_FILE=
# TLS_KEY_FILE=


# ─── 3. PUERTOS Y URLs ───────────────────────────────────────────────────────
# Puerto del backend (Express + WebSocket).
# PORT=3000

# Puerto del dev server del frontend (Vite). Con HTTPS=true se abre en
# https://localhost:5173
# FRONTEND_PORT=5173

# Puerto del backend al que Vite hace proxy. Debe coincidir con PORT.
# Cambiá los tres juntos si querés levantar una segunda copia en paralelo.
# BACKEND_PORT=3000

# Adonde vuelve el navegador después del callback de OAuth.
# FRONTEND_URL=https://localhost:5173

# Redirect URI registrado en tu app de Twitch. Si cambiás PORT, cambialo acá
# y también en el panel de dev.twitch.tv.
# TWITCH_REDIRECT_URI=https://localhost:3000/auth/callback


# ─── 4. BASE DE DATOS ────────────────────────────────────────────────────────
# Archivo SQLite con los tokens, las preferencias por usuario y los ajustes
# globales. Se crea solo al primer arranque.
# Default: backend/data/app.sqlite
# DB_FILE=/ruta/absoluta/a/app.sqlite


# ─── 5. TTS — edge-tts (voces neuronales de Microsoft, requiere internet) ────
# Motor de servidor con ~45 voces en español. Es el default de la voz global.
# Ponelo en false para trabajar sin red: entonces no se registra y las voces
# `edge:*` se leen con el motor del navegador.
# TTS_EDGE_ENABLED=true

# Tope por llamada (síntesis o catálogo) antes de darla por fallida y caer al
# motor del navegador.
# TTS_EDGE_TIMEOUT_MS=8000

# Proxy HTTP para salir a internet (redes corporativas). Vacío = conexión directa.
# TTS_EDGE_PROXY=

# Idiomas del catálogo de voces. `es` = solo español; `*` = todos los que ofrece.
# TTS_EDGE_VOICE_LANGS=es


# ─── 6. TTS — Piper (voces neuronales locales, funciona sin internet) ────────
# Se instala con `npm run setup:piper` (descarga binario + modelos es_ES/es_MX).
# Si no está instalado, la app funciona igual y sus voces no aparecen.
# TTS_PIPER_ENABLED=true

# Carpeta raíz de la instalación. OJO: es la raíz `vendor`, NO `vendor/piper`
# — apuntarla un nivel más abajo hace que Piper se reporte como no instalado.
# Default: backend/vendor
# TTS_PIPER_DIR=/ruta/absoluta/a/backend/vendor

# Carpeta con los modelos `.onnx` + `.onnx.json`.
# Default: <TTS_PIPER_DIR>/piper-voices
# TTS_PIPER_VOICES_DIR=

# Binario de Piper, si lo instalaste por otra vía (brew, manual, etc.).
# Default: el que dejó `setup:piper` dentro de TTS_PIPER_DIR.
# TTS_PIPER_BIN=

# Tope por síntesis antes de matar el proceso y caer al motor del navegador.
# TTS_PIPER_TIMEOUT_MS=15000


# ─── 7. TTS — SAPI (voces de Windows, funciona sin internet) ────────────────
# Usa las voces `System.Speech` que ya trae Windows. No hay nada que instalar;
# fuera de Windows, o si Windows no tiene ninguna voz, el motor se registra
# igual pero sus voces `sapi:*` no aparecen.
# TTS_SAPI_ENABLED=true


# ─── 7b. TTS — Loquendo TTS 7 (si está instalado aparte) ────────────────────
# Mismo mecanismo que SAPI de arriba, pero separado en su propio catálogo
# `loquendo:*`: si tenés Loquendo TTS 7 instalado (voces como Jorge, Carmen,
# Carlos, Soledad), aparecen agrupadas aparte de las nativas de Windows. No
# hay nada que instalar desde acá — este motor solo lee lo que ya esté puesto
# en el sistema. Sin Loquendo instalado, el catálogo sale vacío y no aparece
# nada, igual que los demás motores opcionales.
# TTS_LOQUENDO_ENABLED=true


# ─── 8. TTS — MeloTTS (voz neuronal en español, requiere Docker) ────────────
# Motor de mejor calidad que Piper, con pesos MIT (a diferencia de XTTS-v2 o
# Fish Speech, que son de uso no-comercial). Corre en un contenedor aparte:
#   docker compose up -d melotts   (la primera vez compila la imagen, tarda)
# Si el contenedor no está arriba, la app funciona igual y sus voces `melo:*`
# no aparecen — misma degradación limpia que Piper sin instalar.
# TTS_MELO_ENABLED=true

# URL del contenedor. Default: el puerto que publica `docker-compose.yml`.
# TTS_MELO_URL=http://localhost:8100

# Tope por request (catálogo o síntesis) antes de darla por fallida y caer al
# motor del navegador.
# TTS_MELO_TIMEOUT_MS=20000


# ─── 9. TEMPORIZADORES DE TWITCH (rara vez hace falta tocarlos) ─────────────
# Cada cuánto se consulta Get Chatters para saber quién está presente en el chat.
# Twitch no notifica entradas y salidas, así que esto es polling.
# TWITCH_CHATTERS_POLL_MS=60000

# Cada cuánto revisa el relay si ya hay (o dejó de haber) sesión activa.
# TWITCH_CHAT_SESSION_POLL_MS=5000

# Cada cuánto se revisa si el access token está por expirar (se refresca con
# 5 minutos de margen, sin intervención tuya).
# TWITCH_TOKEN_CHECK_INTERVAL_MS=60000

# Keepalive que se le pide a EventSub (Twitch admite 10–600 s). Si pasa ese
# tiempo más un margen sin recibir nada, la conexión se da por muerta y reconecta.
# TWITCH_EVENTSUB_KEEPALIVE_SECONDS=30


# ─── 10. SERVICIO DE VIEWER (T-015): login + "!configura-mi-voz" ────────────
# `viewer/server.js` es un proceso APARTE del backend admin de arriba — el
# único pensado para exponerse a internet (ver
# docs/exec-plans/active/configura-mi-voz.md). El backend admin (moderación,
# enviar chat como vos, ajustes) sigue siempre solo en `localhost`.

# Puerto donde escucha `viewer/server.js`.
# VIEWER_SERVICE_PORT=3100

# URL pública que el bot postea en el chat con `!configura-mi-voz`
# (backend/src/chat/commands.js). En dev, el default ya sirve
# (http://localhost:<VIEWER_SERVICE_PORT>); en producción es tu hostname
# público (DDNS + certificado, ver el plan de arriba).
# VIEWER_SERVICE_PUBLIC_URL=https://tuombre.duckdns.org

# HTTPS del servicio de viewer: certificado REAL (Let's Encrypt vía win-acme)
# para tu hostname de DuckDNS — distinto del `mkcert` local de la sección 2
# (ese es solo para `localhost`, no sirve para un hostname público). Default
# de las rutas: certs/duckdns/fullchain.pem y certs/duckdns/privkey.pem
# (`certs/` ya está git-ignorado).
# VIEWER_HTTPS=true
# VIEWER_TLS_CERT_FILE=
# VIEWER_TLS_KEY_FILE=

# Flujo de Twitch OAuth aparte para que un espectador pruebe "soy yo" antes de
# configurar su voz. Usa el mismo TWITCH_CLIENT_ID/SECRET de la sección 1,
# pero con SU PROPIO redirect URI, apuntado al puerto de arriba (NO al del
# backend admin) — nunca reutiliza el del bot y nunca guarda el token del
# viewer en ningún lado, solo su identidad (id/login/nombre) en la tabla
# `viewer_sessions`.
#
# Sin esta variable, `/viewer-auth/*` en `viewer/server.js` responde 404
# entero: el flujo queda deshabilitado en vez de arrancar con un redirect URI
# que no le corresponde.
#
# En dev.twitch.tv, agregá esta URL como un SEGUNDO "OAuth Redirect URL" de la
# misma app (no reemplaces la del bot).
# TWITCH_VIEWER_REDIRECT_URI=http://localhost:3100/viewer-auth/callback

# Cuánto dura logueado un viewer antes de tener que volver a pasar por Twitch.
# TWITCH_VIEWER_SESSION_TTL_MS=1800000

# DuckDNS (hostname público estable): mantiene <DUCKDNS_DOMAIN>.duckdns.org
# apuntando a tu IP actual (lo actualiza `scripts/duckdns-update.mjs`, proceso
# `tts-duckdns` de PM2, cada 5 min por default). Creá la cuenta gratis en
# duckdns.org y sacá tu token de ahí — NUNCA lo commitees. Sin estas dos
# variables el actualizador queda inactivo, no rompe nada.
# DUCKDNS_DOMAIN=tuombre
# DUCKDNS_TOKEN=
# DUCKDNS_UPDATE_INTERVAL_MS=300000


# ─── 11. DESARROLLO: apuntar a los imitadores locales ───────────────────────
# Estos tres endpoints apuntan por default a Twitch REAL. Descomentalos solo
# para probar la app sin credenciales, contra los imitadores locales de
# `backend/scripts/fake-*.js`. Con esto NO hablás con Twitch.
#
# Levantar la cadena de imitadores (cada uno delega en el siguiente):
#   node backend/scripts/fake-eventsub.js   --port 4110
#   node backend/scripts/fake-helix-chat.js --port 4120 --eventsub http://localhost:4110
#   node backend/scripts/fake-chatters.js   --port 4130 --forward http://localhost:4120
#
# y descomentar:
#   TWITCH_AUTH_BASE_URL=http://localhost:4130
#   TWITCH_API_BASE_URL=http://localhost:4130
#   TWITCH_EVENTSUB_WS_URL=ws://localhost:4110/ws
#
# Con los imitadores, TWITCH_CLIENT_ID y TWITCH_CLIENT_SECRET pueden ser
# cualquier cosa (deben coincidir con los que reciban los imitadores por entorno).
#
# TWITCH_AUTH_BASE_URL=https://id.twitch.tv
# TWITCH_API_BASE_URL=https://api.twitch.tv
# TWITCH_EVENTSUB_WS_URL=wss://eventsub.wss.twitch.tv/ws
